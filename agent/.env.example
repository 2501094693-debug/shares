OPENAI_API_KEY=sk-your-key-here
# 可选：兼容 OpenAI 的 API 地址
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.3
LLM_REQUEST_TIMEOUT=600
LLM_MAX_RETRIES=2

# 数据采集窗口（天），默认近一年
DATA_LOOKBACK_DAYS=365

# test 项目 backend 路径
BACKEND_ROOT=c:\Users\Administrator\Desktop\test\backend

# ai-berkshire 工具路径（financial_rigor / report_audit）
AI_BERKSHIRE_ROOT=c:\Users\Administrator\PycharmProjects\ai-berkshire

# 联网搜索（Tavily 优先，未配置则使用 DuckDuckGo）
ENABLE_WEB_SEARCH=true
# TAVILY_API_KEY=tvly-xxx
WEB_SEARCH_MAX_RESULTS=8
