# 公司新闻智能体 — OpenAI 兼容接口（可选）
# 未配置时使用关键词启发式筛选
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 高德地图 JS API（行业页注册地地图）
# 在 https://console.amap.com/ 创建 Web 端(JS API) Key
AMAP_JS_KEY=94384f24a3508d3672f1bdf23150575e
# 若控制台开启了安全密钥，填写对应 securityJsCode
AMAP_SECURITY_CODE=2929dc87ebd2d567a6540348df034ea2
# 地理编码（注册地址→坐标）推荐单独创建「Web服务」Key，并开通「地理编码」
# 未配置时回退使用 AMAP_JS_KEY（需该 Key 具备 Web 服务权限）
AMAP_WEB_KEY=

# 同花顺 iFinD 数据接口（逐笔成交 / 委托）。手机 Level-2 会员不能登录此接口。
# SDK：安装 iFinDPy 后填账号密码；HTTP：超级命令「工具 → refresh_token 查询」
IFIND_USER=
IFIND_PASSWORD=
IFIND_REFRESH_TOKEN=
# 逐笔委托指标（超级命令生成）。未开通时 /l2/orders 会失败。
# IFIND_ORDER_INDICATORS=wt_time;wt_price;wt_volume;wt_bs;wt_type
