# 公司新闻智能体 — OpenAI 兼容接口（可选）
# 未配置时使用关键词启发式筛选
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# 投研/业务简述读取 LLM_MODEL，未配置时回退 OPENAI_MODEL
# DeepSeek 请用：OPENAI_BASE_URL=https://api.deepseek.com/v1 且 LLM_MODEL=deepseek-v4-pro
LLM_MODEL=

# 高德地图 JS API（行业页注册地地图）
# 在 https://console.amap.com/ 创建 Web 端(JS API) Key
AMAP_JS_KEY=94384f24a3508d3672f1bdf23150575e
# 若控制台开启了安全密钥，填写对应 securityJsCode
AMAP_SECURITY_CODE=2929dc87ebd2d567a6540348df034ea2
# 地理编码 / POI 实景图推荐单独创建「Web服务」Key，并开通「搜索」
# 未配置时回退使用 AMAP_JS_KEY（需该 Key 具备 Web 服务权限）
AMAP_WEB_KEY=

# Google Maps JS API（谷歌地图页 /gmap，含街景全景）
# 全球页优先使用 Google，不可用时回退高德 AMAP_JS_KEY
# 在 https://console.cloud.google.com/ 启用 Maps JavaScript API、Places API、Geocoding API
# 街景全景走 Maps JavaScript API；三维俯瞰还需启用 Map Tiles API
# 若 Key 做了 API 限制，勾选 Maps JavaScript API、Places API、Geocoding API、Map Tiles API
# 浏览器限制请加上 http://127.0.0.1:5000/* ；国内网络可能需要可访问 Google 的环境
GOOGLE_MAPS_API_KEY=

# 投研 / 业务简述联网搜索（Tavily 优先，未配置则必应国内版）
ENABLE_WEB_SEARCH=true
# TAVILY_API_KEY=tvly-xxx
WEB_SEARCH_MAX_RESULTS=8
