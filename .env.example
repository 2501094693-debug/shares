# 公司新闻智能体 — OpenAI 兼容接口（可选）
# 未配置时使用关键词启发式筛选
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# 投研/业务简述读取 LLM_MODEL，未配置时回退 OPENAI_MODEL
# DeepSeek 请用：OPENAI_BASE_URL=https://api.deepseek.com/v1 且 LLM_MODEL=deepseek-v4-pro
LLM_MODEL=

# 高德地图 JS API（行业页注册地地图）
# 在 https://console.amap.com/ 创建 Web 端(JS API) Key
AMAP_JS_KEY=94384f24a3508d3672f1bdf23150575e
# 若控制台开启了安全密钥，填写对应 securityJsCode
AMAP_SECURITY_CODE=2929dc87ebd2d567a6540348df034ea2
# 地理编码 / POI 实景图推荐单独创建「Web服务」Key，并开通「搜索」
# 未配置时回退使用 AMAP_JS_KEY（需该 Key 具备 Web 服务权限）
AMAP_WEB_KEY=

# 投研 / 业务简述联网搜索（Tavily 优先，未配置则必应国内版）
ENABLE_WEB_SEARCH=true
# TAVILY_API_KEY=tvly-xxx
WEB_SEARCH_MAX_RESULTS=8
